{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": "./src",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["./src"],
  "exclude": ["node_modules", "build", "src/__tests__", "src/**/*.test.*", "src/**/*.spec.*"]
}
